@{
    var title = ViewData["Title"] as string ?? "Mini MVC";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
        h1 { color: #1a1a2e; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>